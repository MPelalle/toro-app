generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HabitStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum HabitImportance {
  LOW
  MEDIUM
  HIGH
}

enum HabitDurationUnit {
  DAYS
  MONTHS
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  FINISHED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum RoutineKind {
  PERSONAL
  SHARED
}

enum RoutineMemberRole {
  OWNER
  MEMBER
}

enum DietKind {
  PERSONAL
  SHARED
}

enum DietMemberRole {
  OWNER
  MEMBER
}

enum SocialNotificationType {
  REPOST
  ROUTINE_SAVED
}

enum ProfileMessageAudience {
  FRIENDS
  ANYONE
}

/// Perfil de la aplicación. Su `id` debe coincidir con el UUID de auth.users
/// cuando se conecte Supabase Auth.
model User {
  id        String   @id @db.Uuid
  email     String?  @unique
  name      String?
  username  String?  @unique
  /// Identificador público de Comunidad. La unicidad sin distinguir mayúsculas
  /// se completa con un índice funcional en la migración SQL.
  nickname  String?  @unique
  bio       String?
  profileMessageAudience ProfileMessageAudience @default(FRIENDS) @map("profile_message_audience")
  pinHash   String?  @map("pin_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  avatarUrl String? @map("avatar_url")
  loginCount Int @default(0) @map("login_count")
  appSeconds Int @default(0) @map("app_seconds")
  lastActiveAt DateTime? @map("last_active_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  habits Habit[]
  diets DietPlan[]
  routines RoutinePlan[]
  workoutSessions WorkoutSession[]
  dailyVisits AppDailyVisit[]
  badgeAwards UserBadgeAward[]
  authTokens AuthToken[]
  sessions Session[]
  sentFriendships Friendship[] @relation("FriendshipRequester")
  receivedFriendships Friendship[] @relation("FriendshipAddressee")
  routineMemberships RoutineMember[]
  routinesLastUpdated RoutinePlan[] @relation("RoutineLastUpdatedBy")
  dietsLastUpdated DietPlan[] @relation("DietLastUpdatedBy")
  dietMemberships DietMember[]
  dietWeightEntries DietWeightEntry[]
  dietDailyLogs DietDailyLog[]
  dietWeeklyCheckIns DietWeeklyCheckIn[]
  communityStatuses CommunityStatus[]
  profileMessagesSent CommunityProfileMessage[] @relation("ProfileMessageAuthor")
  profileMessagesReceived CommunityProfileMessage[] @relation("ProfileMessageProfile")
  reposts SocialRepost[] @relation("RepostAuthor")
  repostsReceived SocialRepost[] @relation("RepostOriginalAuthor")
  notifications SocialNotification[] @relation("NotificationRecipient")
  notificationsSent SocialNotification[] @relation("NotificationActor")

  @@map("users")
}

model AppDailyVisit {
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@map("app_daily_visits")
}

model UserBadgeAward {
  userId    String   @map("user_id") @db.Uuid
  badgeId   String   @map("badge_id")
  tier      Int
  awardedAt DateTime @default(now()) @map("awarded_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badge_awards")
}

model DietPlan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  sex         String
  age         Int
  weight      Float
  height      Float
  activity    Float
  activityLabel String @map("activity_label")
  goal        String
  mealsPerDay Int      @map("meals_per_day")
  calories    Int
  tdee        Int
  protein     Int
  carbs       Int
  fats        Int
  active      Boolean  @default(true)
  immersiveMode Boolean @default(false) @map("immersive_mode")
  kind        DietKind @default(PERSONAL)
  updatedById String? @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedBy     User?          @relation("DietLastUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  meals         DietMeal[]
  weightEntries DietWeightEntry[]
  dailyLogs     DietDailyLog[]
  weeklyCheckIns DietWeeklyCheckIn[]
  members       DietMember[]

  @@index([userId, active])
  @@index([kind, updatedAt])
  @@index([userId, createdAt])
  @@map("diet_plans")
}

model DietMeal {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietId    String   @map("diet_id") @db.Uuid
  position  Int
  name      String
  time      String
  kcal      Int
  protein   Int
  carbs     Int
  fats      Int
  foods     Json
  createdAt DateTime @default(now()) @map("created_at")

  diet DietPlan @relation(fields: [dietId], references: [id], onDelete: Cascade)

  @@unique([dietId, position])
  @@map("diet_meals")
}

model DietWeightEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietId    String   @map("diet_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  weight    Float
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  diet DietPlan @relation(fields: [dietId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dietId, date])
  @@index([userId, date])
  @@map("diet_weight_entries")
}

model DietDailyLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietId           String   @map("diet_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  date             DateTime @db.Date
  completedMealIds Json     @map("completed_meal_ids")
  comment          String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  diet DietPlan @relation(fields: [dietId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dietId, userId, date])
  @@index([userId, date])
  @@map("diet_daily_logs")
}

/// Revisión semanal opcional del modo inmersivo. Las comparativas se derivan
/// de estos registros y de la adherencia diaria, sin duplicar métricas agregadas.
model DietWeeklyCheckIn {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dietId         String   @map("diet_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  weekStart      DateTime @map("week_start") @db.Date
  weight         Float
  feeling        String
  energy         Int
  hunger         Int
  note           String?
  adjustmentKcal Int      @default(0) @map("adjustment_kcal")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  diet DietPlan @relation(fields: [dietId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dietId, userId, weekStart])
  @@index([userId, weekStart])
  @@map("diet_weekly_check_ins")
}

model DietMember {
  dietId    String         @map("diet_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      DietMemberRole @default(MEMBER)
  createdAt DateTime       @default(now()) @map("created_at")

  diet DietPlan @relation(fields: [dietId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([dietId, userId])
  @@index([userId, createdAt])
  @@map("diet_members")
}

model AuthToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  type      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Habit {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  name          String
  icon          String            @default("CircleCheck")
  importance    HabitImportance   @default(MEDIUM)
  durationValue Int               @default(30) @map("duration_value")
  durationUnit  HabitDurationUnit @default(DAYS) @map("duration_unit")
  status        HabitStatus       @default(ACTIVE)
  notes         String?
  startsAt      DateTime          @default(now()) @map("starts_at")
  endsAt        DateTime?         @map("ends_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns HabitCheckIn[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("habits")
}

/// Un registro por hábito y día. Las métricas semanales se calculan a partir
/// de estos check-ins, por lo que no se almacenan porcentajes desactualizados.
model HabitCheckIn {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  habitId     String   @map("habit_id") @db.Uuid
  completedAt DateTime @map("completed_at") @db.Date
  completed   Boolean  @default(true)
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, completedAt])
  @@index([completedAt])
  @@map("habit_check_ins")
}

model RoutinePlan {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  type      String
  kind      RoutineKind @default(PERSONAL)
  days      Json
  active    Boolean  @default(false)
  isPublished Boolean @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  importedFromRoutineId String? @map("imported_from_routine_id") @db.Uuid
  importedFromUserId String? @map("imported_from_user_id") @db.Uuid
  importedFromCreatorName String? @map("imported_from_creator_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedById String? @map("updated_by_id") @db.Uuid

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedBy User?             @relation("RoutineLastUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  exercises RoutineExercise[]
  members   RoutineMember[]
  workoutSessions WorkoutSession[]

  @@index([userId, kind, active])
  @@index([userId, isPublished, publishedAt])
  @@index([kind, isPublished, publishedAt])
  @@index([importedFromRoutineId])
  @@unique([userId, importedFromRoutineId])
  @@index([kind, updatedAt])
  @@index([userId, createdAt])
  @@map("routine_plans")
}

model CommunityStatus {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("community_statuses")
}

/// Texto breve dejado por un amigo en el perfil de otro atleta.
model CommunityProfileMessage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  profileUserId String   @map("profile_user_id") @db.Uuid
  content       String
  createdAt     DateTime @default(now()) @map("created_at")

  author      User @relation("ProfileMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  profileUser User @relation("ProfileMessageProfile", fields: [profileUserId], references: [id], onDelete: Cascade)

  @@index([profileUserId, createdAt])
  @@index([authorId, createdAt])
  @@map("community_profile_messages")
}

model SocialRepost {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  originalAuthorId  String   @map("original_author_id") @db.Uuid
  originalType      String   @map("original_type")
  originalId        String   @map("original_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user           User @relation("RepostAuthor", fields: [userId], references: [id], onDelete: Cascade)
  originalAuthor User @relation("RepostOriginalAuthor", fields: [originalAuthorId], references: [id], onDelete: Cascade)

  @@unique([userId, originalType, originalId])
  @@index([userId, createdAt])
  @@index([originalAuthorId, createdAt])
  @@map("social_reposts")
}

model SocialNotification {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  actorId    String                 @map("actor_id") @db.Uuid
  type       SocialNotificationType
  targetType String                 @map("target_type")
  targetId   String                 @map("target_id")
  createdAt  DateTime               @default(now()) @map("created_at")
  readAt     DateTime?              @map("read_at")

  user  User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([userId, actorId, type, targetId])
  @@index([userId, readAt, createdAt])
  @@map("social_notifications")
}

/// Las columnas user_a_id/user_b_id siempre se almacenan ordenadas por UUID.
/// De ese modo una única constraint cubre A→B y B→A.
model Friendship {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  addresseeId String           @map("addressee_id") @db.Uuid
  userAId     String           @map("user_a_id") @db.Uuid
  userBId     String           @map("user_b_id") @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@map("friendships")
}

model RoutineMember {
  routineId  String            @map("routine_id") @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  role       RoutineMemberRole @default(MEMBER)
  createdAt  DateTime          @default(now()) @map("created_at")

  routine RoutinePlan @relation(fields: [routineId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([routineId, userId])
  @@index([userId, createdAt])
  @@map("routine_members")
}

model RoutineExercise {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routineId   String   @map("routine_id") @db.Uuid
  catalogExerciseId String? @map("catalog_exercise_id")
  position    Int
  name        String
  muscle      String
  sets        Int
  reps        Int
  weight      Float
  technique   String
  trainingDay String   @map("training_day")
  completed   Boolean? @default(false)
  actualReps  Int?     @map("actual_reps")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  routine RoutinePlan @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, position])
  @@index([routineId])
  @@map("routine_exercises")
}

model WorkoutSession {
  /// UUID generado en el cliente. Permite reintentos seguros después de una pérdida de red.
  id              String               @id @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  routineId       String               @map("routine_id") @db.Uuid
  status          WorkoutSessionStatus @default(IN_PROGRESS)
  startedAt       DateTime             @map("started_at")
  finishedAt      DateTime?            @map("finished_at")
  durationSeconds Int?                 @map("duration_seconds")
  notes           String?
  emotionalRating Int?                 @map("emotional_rating")
  emotionalState  String?              @map("emotional_state")
  version         Int                  @default(1)
  clientUpdatedAt DateTime             @map("client_updated_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine   RoutinePlan            @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises WorkoutSessionExercise[]

  @@index([userId, routineId, status])
  @@index([userId, status, finishedAt])
  @@index([userId, clientUpdatedAt])
  @@map("workout_sessions")
}

model WorkoutSessionExercise {
  /// UUID generado en el cliente junto con la sesión.
  id                String @id @db.Uuid
  sessionId         String @map("session_id") @db.Uuid
  routineExerciseId String @map("routine_exercise_id") @db.Uuid
  catalogExerciseId String? @map("catalog_exercise_id")
  position          Int
  name              String
  muscle            String

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sets    WorkoutSet[]

  @@unique([sessionId, position])
  @@index([sessionId])
  @@map("workout_session_exercises")
}

model WorkoutSet {
  /// UUID generado en el cliente. Reenviar una sesión no duplica sus series.
  id                String   @id @db.Uuid
  sessionExerciseId String   @map("session_exercise_id") @db.Uuid
  setNumber         Int      @map("set_number")
  targetReps        Int      @map("target_reps")
  targetWeight      Float    @map("target_weight")
  reps              Int?
  weight            Float?
  rir               Int?
  rpe               Int?
  kind              String   @default("NORMAL")
  note              String?
  completed         Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  exercise WorkoutSessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@unique([sessionExerciseId, setNumber])
  @@index([sessionExerciseId])
  @@map("workout_sets")
}
