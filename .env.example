# Runtime database connection: use Supabase's pooled connection string in Vercel.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true

# Direct database connection: used only by `prisma migrate deploy` at build time.
DIRECT_URL=postgresql://postgres:[PASSWORD]@[DIRECT_HOST]:5432/postgres

# Supabase Storage (server-only service credential).
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[SUPABASE_SERVICE_ROLE_KEY]
SUPABASE_STORAGE_BUCKET=profile-photos
SUPABASE_PROGRESS_PHOTOS_BUCKET=progress-photos

# Canonical public HTTPS URL, with no trailing slash.
APP_URL=https://your-domain.vercel.app

# Transactional mail provider. Port 587 uses STARTTLS; port 465 uses implicit TLS.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=[SMTP_USERNAME]
SMTP_PASSWORD=[SMTP_PASSWORD]
SMTP_FROM=TORO <no-reply@your-domain.com>
